<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vectorize.Hindsight.Sdk</RootNamespace>
    <AssemblyName>Vectorize.Hindsight.Sdk</AssemblyName>
    <PackageId>Vectorize.Hindsight.Sdk</PackageId>

    <Description>A dependency-light .NET client for the Hindsight agent-memory HTTP API. Covers the full non-deprecated surface: memory banks, retain, recall, reflect, entities, directives, mental models, knowledge base, documents, webhooks, operations and transfers.</Description>
    <PackageTags>hindsight;vectorize;agent;memory;ai;sdk;client;rest</PackageTags>

    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- The library is trimmable and Native AOT friendly: every serializer
         path is source-generated and no reflection is used over caller types.
         The analyzers below are what enforce that claim rather than merely
         asserting it, so they are active in every build, not only in CI. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Verified by a consumer smoke test, described in the README: the same
         public surface works when trimmed and when ahead-of-time compiled. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository README ships inside the package, so a consumer sees what
         the package is without leaving the client. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
