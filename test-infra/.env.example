# Copy to .env only if you need to override the defaults.
# up.sh resolves the key from HINDSIGHT_API_LLM_API_KEY, then from
# ~/.hermes/.env (OLLAMA_API_KEY). Never commit a real key.

HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=glm-5.3-flash
HINDSIGHT_API_LLM_BASE_URL=https://ollama.com/v1
# HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_TEST_API_PORT=8888
